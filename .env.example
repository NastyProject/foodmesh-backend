ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://foodmesh:foodmesh@localhost:5432/foodmesh
# Auth0: dominio del tenant (sin https://) y el Identifier de la API
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.foodmesh.example
# Gemini (normalización de facturas). La API key se crea en Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Almacenamiento de imágenes de facturas: "local" (disco) o "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# Solo con STORAGE_BACKEND=s3. Las credenciales las lee boto3 de
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY y AWS_DEFAULT_REGION.
S3_BUCKET=
# Lista JSON de orígenes permitidos por CORS
CORS_ORIGINS=["http://localhost:5173"]
