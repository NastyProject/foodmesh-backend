ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://foodmesh:foodmesh@localhost:5432/foodmesh
# Auth0: dominio del tenant (sin https://) y el Identifier de la API
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.foodmesh.example
# Gemini (normalización de facturas). La API key se crea en Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo de respaldo: un intento con él si el principal agota sus reintentos por
# 429/503/timeout. Vacío para no usar respaldo. Debe aceptar thinking "minimal".
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite
# Modelo de Gemini para recomendar recetas (puede ser distinto del de facturas)
GEMINI_MODEL_RECETAS=gemini-3.5-flash-lite
GEMINI_MODEL_RECETAS_RESPALDO=gemini-3.1-flash-lite
# Timeout de cada llamada a Gemini, en segundos (mínimo 10). Hay un reintento ante 429/503/timeout.
# Interactivo: recetas pedidas por el usuario y facturas. Fondo: precálculo de recetas.
GEMINI_TIMEOUT_INTERACTIVO=45
GEMINI_TIMEOUT_FONDO=90
# Precalcular recetas en segundo plano cuando cambian el inventario o las preferencias
PRECALCULAR_RECETAS=true
# Caché de recetas en Redis (docker compose up -d redis). Si no responde, se trabaja sin caché.
REDIS_URL=redis://localhost:6379/0
# Cuánto dura una receta en caché, en segundos
RECETAS_CACHE_TTL=86400
# Almacenamiento de imágenes de facturas: "local" (disco) o "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# Solo con STORAGE_BACKEND=s3. Las credenciales las lee boto3 de
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY y AWS_DEFAULT_REGION.
S3_BUCKET=
# Lista JSON de orígenes permitidos por CORS
CORS_ORIGINS=["http://localhost:5173"]
