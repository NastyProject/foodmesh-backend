# Configuración de producción (EC2). Copiar a deploy/.env y completar:
#   cp .env.prod.example .env && chmod 600 .env
# La leen la API (env_file) y Docker Compose (DOMINIO). Nunca subir el .env al repo.

ENVIRONMENT=production

# --- Dominio y servidor ---
# Dominio que apunta a la IP pública de la EC2 (registro A). Caddy saca el certificado
# HTTPS para este nombre. Sin dominio propio sirve sslip.io: para la IP 3.80.1.2,
# DOMINIO=3-80-1-2.sslip.io (cambia si cambia la IP: usar una Elastic IP).
DOMINIO=api.foodmesh.example
# Versión de la imagen: latest, o el sha de un commit para fijarla o volver atrás.
API_TAG=latest
# Procesos de uvicorn. 2 para una t3.small/t3.medium; cada uno usa ~200-300 MB de RAM.
WEB_CONCURRENCY=2

# --- Base de datos: Amazon RDS PostgreSQL ---
# sslmode=require: el tráfico a RDS va cifrado. Si la contraseña tiene caracteres
# especiales (@ : / ? #), van codificados en la URL (@ es %40).
DATABASE_URL=postgresql+psycopg://foodmesh:CAMBIAR@foodmesh-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/foodmesh?sslmode=require

# --- Redis: el contenedor del docker-compose.prod.yml ---
REDIS_URL=redis://redis:6379/0
RECETAS_CACHE_TTL=86400

# --- Imágenes de facturas: S3 ---
# Sin AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY: boto3 toma credenciales temporales
# del instance profile de la EC2 (LabInstanceProfile). Ver deploy/README.md.
STORAGE_BACKEND=s3
S3_BUCKET=foodmesh-facturas-CAMBIAR
AWS_DEFAULT_REGION=us-east-1

# --- Auth0 ---
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.foodmesh.example

# --- Gemini ---
GEMINI_API_KEY=CAMBIAR
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite
GEMINI_MODEL_RECETAS=gemini-3.5-flash-lite
GEMINI_MODEL_RECETAS_RESPALDO=gemini-3.1-flash-lite
GEMINI_TIMEOUT_INTERACTIVO=45
GEMINI_TIMEOUT_FONDO=90
PRECALCULAR_RECETAS=true

# --- CORS: lista JSON con la URL del frontend desplegado ---
CORS_ORIGINS=["https://foodmesh.example"]
